// mos6502 - instruction_table.def
//
// The single source of truth for the instruction set. Three consumers expand
// this list - the dispatch switch, the disassembler, and the test suite's
// reference tables - so they cannot drift apart.
//
//   X(opcode, mnemonic, operation, addressing mode, instruction shape)
//
// Undocumented opcodes are marked with a trailing comment. Cycle counts are
// deliberately absent: they emerge from the accesses each shape performs.

X(0x00, "BRK", BRK,   Implied,     SpecialInstr)
X(0x01, "ORA", ORA,   IndirectX,   ReadInstr)
X(0x02, "JAM", JAM,   Implied,     SpecialInstr)   // undocumented
X(0x03, "SLO", SLO,   IndirectX,   RmwInstr)       // undocumented
X(0x04, "NOP", NOP_R, ZeroPage,    ReadInstr)      // undocumented
X(0x05, "ORA", ORA,   ZeroPage,    ReadInstr)
X(0x06, "ASL", ASL,   ZeroPage,    RmwInstr)
X(0x07, "SLO", SLO,   ZeroPage,    RmwInstr)       // undocumented
X(0x08, "PHP", PHP,   Implied,     ImpliedInstr)
X(0x09, "ORA", ORA,   Immediate,   ReadInstr)
X(0x0A, "ASL", ASL,   Accumulator, AccumInstr)
X(0x0B, "ANC", ANC,   Immediate,   ReadInstr)      // undocumented
X(0x0C, "NOP", NOP_R, Absolute,    ReadInstr)      // undocumented
X(0x0D, "ORA", ORA,   Absolute,    ReadInstr)
X(0x0E, "ASL", ASL,   Absolute,    RmwInstr)
X(0x0F, "SLO", SLO,   Absolute,    RmwInstr)       // undocumented

