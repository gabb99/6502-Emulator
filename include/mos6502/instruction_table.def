X(0x17, "SLO", SLO,   ZeroPageX,   RmwInstr)       // undocumented
X(0x18, "CLC", CLC,   Implied,     ImpliedInstr)
X(0x19, "ORA", ORA,   AbsoluteY,   ReadInstr)
